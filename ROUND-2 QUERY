WITH CTE1 AS (
SELECT DATE, RESOURCE_ID, START_TIME,END_TIME,CAST(
    (JULIANDAY(END_TIME) - JULIANDAY(START_TIME)) * 24 * 60 * 60
AS INTEGER) AS MINUTE_DIFF FROM TEST_DE 
WHERE MINUTE_DIFF >=0),
CTE2 AS (
SELECT DATE,RESOURCE_ID,ROUND(SUM(MINUTE_DIFF) / 3600.0, 2) TOTAL_HRS FROM CTE1 GROUP BY 1,2),
CTE3 AS (
SELECT
    RESOURCE_ID,
    DATE,
    START_TIME,
    END_TIME,
    CASE
        WHEN START_TIME = MIN(START_TIME) OVER (PARTITION BY RESOURCE_ID, DATE)
        THEN 1
        ELSE 0
    END AS IS_CLOCK_IN,
    CASE
        WHEN END_TIME = MAX(END_TIME) OVER (PARTITION BY RESOURCE_ID, DATE)
        THEN 1
        ELSE 0
    END AS IS_CLOCK_OUT
FROM TEST_DE
ORDER BY DATE,RESOURCE_ID),
IS_CLOCK_IN AS (
SELECT DATE,RESOURCE_ID,IS_CLOCK_IN,START_TIME FROM CTE3
  WHERE IS_CLOCK_IN = 1
),
IS_CLOCK_OUT AS (
SELECT DATE,RESOURCE_ID,IS_CLOCK_OUT,END_TIME FROM CTE3
  WHERE IS_CLOCK_OUT = 1)
  
  SELECT A.DATE,A.RESOURCE_ID,B.START_TIME,C.END_TIME,A.TOTAL_HRS
  FROM CTE2 A 
  INNER JOIN IS_CLOCK_IN B ON A.RESOURCE_ID = B.RESOURCE_ID AND A.DATE = B.DATE
  INNER JOIN IS_CLOCK_OUT C ON A.RESOURCE_ID = C.RESOURCE_ID AND A.DATE = C.DATE
ORDER BY 1,2;
